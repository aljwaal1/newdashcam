    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-feature android:name="android.hardware.camera" android:required="true"/>
    <application android:theme="@style/AppTheme" android:label="داش كام 4.4">
        <activity android:name=".MainActivity" android:screenOrientation="landscape" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
